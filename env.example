# Copy to .env (git-ignored). Values here are for LOCAL development only.
# Shared/hosted database credentials live in your password manager, not here.

# Local Docker Postgres (see docker-compose.yml). Port 5433 avoids clashing
# with anything already on 5432.
POSTGRES_PASSWORD=cadence_local_dev
DATABASE_URL=postgres://cadence:cadence_local_dev@localhost:5433/cadence?sslmode=disable

# API server
PORT=8080
APP_ENV=development
# first (default: open until one family exists), open, or closed
ALLOW_REGISTRATION=first
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty locally.
TRUSTED_PROXY=
