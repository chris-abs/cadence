{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make check-server)",
      "Bash(make check-client)",
      "Bash(make test)",
      "Bash(make gen)",
      "Bash(make migrate)",
      "Bash(make db-up)",
      "Bash(make db-down)",
      "Bash(make dev-server)",
      "Bash(make dev-client)",
      "Bash(make -C server *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go tool *)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run *)",
      "Bash(yarn install --frozen-lockfile)",
      "Bash(yarn dev)",
      "Bash(yarn build)",
      "Bash(yarn typecheck)",
      "Bash(yarn lint *)",
      "Bash(yarn format *)",
      "Bash(yarn format:check)",
      "Bash(yarn test *)",
      "Bash(yarn gen)",
      "Bash(yarn check)",
      "Bash(yarn -s build)",
      "Bash(yarn -s typecheck)",
      "Bash(yarn -s lint *)",
      "Bash(yarn -s format:check)",
      "Bash(yarn -s test *)",
      "Bash(yarn -s gen)",
      "Bash(yarn -s check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(docker compose up -d --wait)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose down)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/legacy/**/.env)",
      "Read(/legacy/**/.env.*)",
      "Edit(/legacy/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git reset --hard*)",
      "Bash(*--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(*LEFTHOOK=0*)",
      "Bash(*MIGRATE_ALLOW_REMOTE*)",
      "Bash(MIGRATE_ALLOW_REMOTE=* *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh pr close*)",
      "Bash(gh pr ready*)",
      "Bash(gh api *merge*)",
      "Bash(gh api *pulls*reviews*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh workflow *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edits.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
